---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { teaser, type TeaserConfig } from '../../config/teaser';
import styles from './PageTeaser.module.css';

export interface TeaserPage { id: string; title: string; thumb: ImageMetadata; }
interface Props extends Partial<TeaserConfig> { pages: TeaserPage[]; }
const { pages, ...overrides } = Astro.props;
const c = { ...teaser, ...overrides };
const vars = `--angle:${c.angle}deg;--tilt:${c.tilt}deg;--visible:${c.visible};--spacing:${c.spacing};--tint:${c.tint};--bend:${c.bend};--scale:${c.scale}`;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(pages.length);
---
<div class={styles.teaser} style={vars} data-teaser>
  <div class={styles.stage} aria-hidden="true">
    <ol class={styles.stack}>
      {pages.map((page, i) => (
        <li class={styles.item} style={`--i:${i}`}>
          <a class={styles.thumb} href={`#${page.id}`} tabindex="-1">
            <Image class={styles.thumbImg} src={page.thumb} alt="" width={240} densities={[1, 2]} loading={i < 3 ? 'eager' : 'lazy'} />
          </a>
        </li>
      ))}
    </ol>
    <p class={styles.caption}>
      <span class={styles.count}><span data-page-number>01</span> / {total}</span>
      <span class={styles.title} data-page-title>{pages[0]?.title}</span>
    </p>
  </div>

  <button class={styles.pill} type="button" popovertarget="seiten">Seite <span data-page-number>01</span> / {total}</button>
  <nav id="seiten" class={styles.pages} aria-label="Seiten" popover data-pages>
    <ol class={styles.list}>
      {pages.map((page, i) => (
        <li>
          <a class={styles.link} href={`#${page.id}`} data-page-link data-title={page.title} aria-current={i === 0 ? 'location' : undefined}>
            <span class={styles.dot} aria-hidden="true"></span>
            <span class={styles.label}><span class={styles.num}>{pad(i + 1)}</span> {page.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</div>
